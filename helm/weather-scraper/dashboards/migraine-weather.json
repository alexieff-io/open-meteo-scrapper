    {
      "id": 1,
      "title": "Pressure Change (6h)",
      "description": "Primary migraine trigger: barometric pressure change over 6 hours. >=6 hPa is moderate risk, >=10 hPa is high risk.",
      "type": "stat",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "editorMode": "code",
          "expr": "abs(weather_pressure_msl{frequency=\"hourly\",location=~\"$location\"} - weather_pressure_msl{frequency=\"hourly\",location=~\"$location\"} offset 6h)",
          "legendFormat": "{{location}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pressurehpa",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 4
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      }
    },
